// ===========================================
// PRISMA SCHEMA - PLATAFORMA IA
// Base multi-tenant foundation
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyUserRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerInteractionType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  FOLLOW_UP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  LOGIN
  LOGOUT
}

model Company {
  id        String        @id @default(uuid())
  name      String
  legalName String?
  document  String?       @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users     CompanyUser[]
  customers Customer[]
  auditLogs    AuditLog[]
  interactions CustomerInteraction[]

  @@map("companies")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  companies    CompanyUser[]
  auditLogs    AuditLog[]
  interactions CustomerInteraction[]

  @@map("users")
}

model CompanyUser {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  role      CompanyUserRole   @default(MEMBER)
  status    CompanyUserStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_users")
}

model Customer {
  id        String         @id @default(uuid())
  companyId String         @map("company_id")
  name      String
  email     String?
  phone     String?
  document  String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interactions CustomerInteraction[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("customers")
}

model CustomerInteraction {
  id          String                  @id @default(uuid())
  companyId   String                  @map("company_id")
  customerId  String                  @map("customer_id")
  userId      String?                 @map("user_id")
  type        CustomerInteractionType
  content     String
  scheduledAt DateTime?               @map("scheduled_at")
  completedAt DateTime?               @map("completed_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@map("customer_interactions")
}

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String      @map("company_id")
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String
  resourceId String?     @map("resource_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([resource])
  @@index([resourceId])
  @@map("audit_logs")
}

model FoundationCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("_foundation_checks")
}
