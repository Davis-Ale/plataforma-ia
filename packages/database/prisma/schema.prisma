generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyUserRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerInteractionType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  FOLLOW_UP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  LOGIN
  LOGOUT
}

enum QueueEventStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BenefitType {
  VA
  VR
  VT
}

enum BenefitStatus {
  ACTIVE
  INACTIVE
}

enum TimeEntryStatus {
  PRESENT
  ABSENT
  LATE
  INCOMPLETE
}

model Company {
  id        String        @id @default(uuid())
  name      String
  legalName String?
  document  String?       @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users                CompanyUser[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  auditLogs            AuditLog[]
  queueEvents          QueueEvent[]
  departments          Department[]
  positions            Position[]
  employees            Employee[]
  contracts            Contract[]
  benefits             Benefit[]
  timeEntries          TimeEntry[]

  @@map("companies")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  companies            CompanyUser[]
  customerInteractions CustomerInteraction[]
  auditLogs            AuditLog[]
  sessions             AuthSession[]

  @@map("users")
}

model CompanyUser {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  role      CompanyUserRole   @default(MEMBER)
  status    CompanyUserStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_users")
}

model Customer {
  id        String         @id @default(uuid())
  companyId String         @map("company_id")
  name      String
  email     String?
  phone     String?
  document  String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interactions CustomerInteraction[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("customers")
}

model CustomerInteraction {
  id          String                  @id @default(uuid())
  companyId   String                  @map("company_id")
  customerId  String                  @map("customer_id")
  userId      String?                 @map("user_id")
  type        CustomerInteractionType
  content     String
  scheduledAt DateTime?               @map("scheduled_at")
  completedAt DateTime?               @map("completed_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@map("customer_interactions")
}

model AuthSession {
  id               String    @id
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String      @map("company_id")
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String
  resourceId String?     @map("resource_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([resource])
  @@index([resourceId])
  @@map("audit_logs")
}

model QueueEvent {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  queueName    String           @map("queue_name")
  jobId        String           @map("job_id")
  jobName      String           @map("job_name")
  status       QueueEventStatus
  attemptsMade Int              @default(0) @map("attempts_made")
  payload      Json?
  result       Json?
  error        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([queueName, jobId])
  @@index([status, createdAt])
  @@map("queue_events")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Position {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  contracts Contract[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("positions")
}

model Employee {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  departmentId String?        @map("department_id")
  positionId   String?        @map("position_id")
  name         String
  cpf          String
  email        String
  status       EmployeeStatus @default(ACTIVE)
  archivedAt   DateTime?      @map("archived_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  contracts  Contract[]
  benefits   Benefit[]
  timeEntries TimeEntry[]

  @@unique([companyId, cpf])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

model Contract {
  id             String         @id @default(uuid())
  companyId      String         @map("company_id")
  employeeId     String         @map("employee_id")
  positionId     String?        @map("position_id")
  employmentType String         @map("employment_type")
  admissionDate  DateTime       @map("admission_date")
  unit           String
  workRegime     String         @map("work_regime")
  status         ContractStatus @default(ACTIVE)
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([positionId])
  @@index([companyId, unit])
  @@map("contracts")
}

model Benefit {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  employeeId String        @map("employee_id")
  type       BenefitType
  status     BenefitStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, type])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([type])
  @@map("benefits")
}

model TimeEntry {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  employeeId     String          @map("employee_id")
  workDate       DateTime        @db.Date @map("work_date")
  clockIn        DateTime?       @map("clock_in")
  clockOut       DateTime?       @map("clock_out")
  workedMinutes  Int             @default(0) @map("worked_minutes")
  lateMinutes    Int             @default(0) @map("late_minutes")
  balanceMinutes Int             @default(0) @map("balance_minutes")
  status         TimeEntryStatus @default(PRESENT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([employeeId, workDate])
  @@map("time_entries")
}

model FoundationCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("_foundation_checks")
}
