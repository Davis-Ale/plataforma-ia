generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyUserRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerInteractionType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  FOLLOW_UP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  LOGIN
  LOGOUT
}

enum QueueEventStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BenefitType {
  VA
  VR
  VT
}

enum BenefitStatus {
  ACTIVE
  INACTIVE
}

enum AbsenceType {
  VACATION
  MEDICAL_LEAVE
  PERSONAL_LEAVE
  UNJUSTIFIED
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimeEntryStatus {
  PRESENT
  ABSENT
  LATE
  INCOMPLETE
}

enum RequestStatus {
  OPEN
  CLOSED
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CapabilityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
}

enum CapabilityApprovalDecision {
  APPROVED
  REJECTED
}

enum CapabilityApprovalPurpose {
  CONTEXT_PREPARATION
  GENERATION
  EXECUTION
}

model Company {
  id        String        @id @default(uuid())
  name      String
  legalName String?
  document  String?       @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users                CompanyUser[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  auditLogs            AuditLog[]
  queueEvents          QueueEvent[]
  departments          Department[]
  positions            Position[]
  employees            Employee[]
  contracts            Contract[]
  benefits             Benefit[]
  timeEntries          TimeEntry[]
  absences             Absence[]
  requests             Request[]
  workflowRuns         WorkflowRun[]
  workflowSteps        WorkflowStep[]
  capabilityApprovals  CapabilityApproval[]
  aiBudgetPolicies     AiBudgetPolicy[]
  aiUsageAttempts      AiUsageAttempt[]

  @@map("companies")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  companies            CompanyUser[]
  customerInteractions CustomerInteraction[]
  auditLogs            AuditLog[]
  sessions             AuthSession[]
  createdRequests      Request[]
  requestedApprovals   CapabilityApproval[] @relation("ApprovalRequester")
  decidedApprovals     CapabilityApproval[] @relation("ApprovalDecider")

  @@map("users")
}

model CompanyUser {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  role      CompanyUserRole   @default(MEMBER)
  status    CompanyUserStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_users")
}

model Customer {
  id        String         @id @default(uuid())
  companyId String         @map("company_id")
  name      String
  email     String?
  phone     String?
  document  String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interactions CustomerInteraction[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("customers")
}

model CustomerInteraction {
  id          String                  @id @default(uuid())
  companyId   String                  @map("company_id")
  customerId  String                  @map("customer_id")
  userId      String?                 @map("user_id")
  type        CustomerInteractionType
  content     String
  scheduledAt DateTime?               @map("scheduled_at")
  completedAt DateTime?               @map("completed_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@map("customer_interactions")
}

model AuthSession {
  id               String    @id
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String      @map("company_id")
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String
  resourceId String?     @map("resource_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([resource])
  @@index([resourceId])
  @@map("audit_logs")
}

model QueueEvent {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  queueName    String           @map("queue_name")
  jobId        String           @map("job_id")
  jobName      String           @map("job_name")
  status       QueueEventStatus
  attemptsMade Int              @default(0) @map("attempts_made")
  payload      Json?
  result       Json?
  error        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([queueName, jobId])
  @@index([status, createdAt])
  @@map("queue_events")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Position {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  contracts Contract[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("positions")
}

model Employee {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  departmentId String?        @map("department_id")
  positionId   String?        @map("position_id")
  name         String
  cpf          String
  email        String
  status       EmployeeStatus @default(ACTIVE)
  archivedAt   DateTime?      @map("archived_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  contracts  Contract[]
  benefits   Benefit[]
  timeEntries TimeEntry[]
  absences    Absence[]

  @@unique([companyId, cpf])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

model Contract {
  id             String         @id @default(uuid())
  companyId      String         @map("company_id")
  employeeId     String         @map("employee_id")
  positionId     String?        @map("position_id")
  employmentType String         @map("employment_type")
  admissionDate  DateTime       @map("admission_date")
  unit           String
  workRegime     String         @map("work_regime")
  status         ContractStatus @default(ACTIVE)
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([positionId])
  @@index([companyId, unit])
  @@map("contracts")
}

model Benefit {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  employeeId String        @map("employee_id")
  type       BenefitType
  status     BenefitStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, type])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([type])
  @@map("benefits")
}

model TimeEntry {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  employeeId     String          @map("employee_id")
  workDate       DateTime        @db.Date @map("work_date")
  clockIn        DateTime?       @map("clock_in")
  clockOut       DateTime?       @map("clock_out")
  workedMinutes  Int             @default(0) @map("worked_minutes")
  lateMinutes    Int             @default(0) @map("late_minutes")
  balanceMinutes Int             @default(0) @map("balance_minutes")
  status         TimeEntryStatus @default(PRESENT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([employeeId, workDate])
  @@map("time_entries")
}

model Absence {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  employeeId String        @map("employee_id")
  type       AbsenceType
  startDate  DateTime      @db.Date @map("start_date")
  endDate    DateTime      @db.Date @map("end_date")
  reason     String?
  status     AbsenceStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, startDate])
  @@index([companyId, createdAt])
  @@index([employeeId, startDate])
  @@map("absences")
}

model Request {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  createdByUserId String        @map("created_by_user_id")
  title           String
  description     String
  status          RequestStatus @default(OPEN)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("requests")
}

model WorkflowRun {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  workflowKey String         @map("workflow_key")
  status      WorkflowStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps   WorkflowStep[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("workflow_runs")
}

model WorkflowStep {
  id            String         @id @default(uuid())
  companyId     String         @map("company_id")
  workflowRunId String         @map("workflow_run_id")
  stepKey       String         @map("step_key")
  stepOrder     Int            @map("step_order")
  status        WorkflowStatus @default(PENDING)
  input         Json?
  output        Json?
  error         String?
  startedAt     DateTime?      @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([companyId, workflowRunId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("workflow_steps")
}

model FoundationCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("_foundation_checks")
}

model CapabilityApproval {
  id                String                     @id @default(uuid())
  companyId         String                     @map("company_id")
  requestedByUserId String                     @map("requested_by_user_id")
  capabilityKey     String                     @map("capability_key")
  inputHash         String                     @map("input_hash")
  purpose           CapabilityApprovalPurpose?
  status            CapabilityApprovalStatus   @default(PENDING)
  decision          CapabilityApprovalDecision?
  decidedByUserId   String?                    @map("decided_by_user_id")
  decidedAt         DateTime?                  @map("decided_at")
  consumedAt        DateTime?                  @map("consumed_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("ApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, requestedByUserId])
  @@map("capability_approvals")
}

enum AiUsageStatus {
  RESERVED
  COMPLETED
  FAILED
  CANCELLED
}

model AiBudgetPolicy {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  periodKey           String   @map("period_key")
  periodStart         DateTime @map("period_start")
  periodEnd           DateTime @map("period_end")
  currency            String
  enabled             Boolean  @default(false)
  tokenLimit          BigInt   @map("token_limit")
  costLimitMicros     BigInt   @map("cost_limit_micros")
  maxConcurrent       Int      @map("max_concurrent")
  reservedTokens      BigInt   @default(0) @map("reserved_tokens")
  spentTokens         BigInt   @default(0) @map("spent_tokens")
  reservedCostMicros  BigInt   @default(0) @map("reserved_cost_micros")
  spentCostMicros     BigInt   @default(0) @map("spent_cost_micros")
  activeReservations  Int      @default(0) @map("active_reservations")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attempts AiUsageAttempt[]

  @@unique([companyId, periodKey])
  @@unique([id, companyId])
  @@index([companyId, periodStart, periodEnd])
  @@map("ai_budget_policies")
}

model AiUsageAttempt {
  id                  String        @id @default(uuid())
  companyId           String        @map("company_id")
  userId              String        @map("user_id")
  budgetId            String        @map("budget_id")
  operationId         String        @map("operation_id")
  attemptNumber       Int           @map("attempt_number")
  requestHash         String        @map("request_hash")
  settlementHash      String?       @map("settlement_hash")
  correlationId       String        @map("correlation_id")
  modelClass          String        @map("model_class")
  logicalModel        String        @map("logical_model")
  capabilityKey       String        @map("capability_key")
  workflowRunId       String?       @map("workflow_run_id")
  workflowStepId      String?       @map("workflow_step_id")
  status              AiUsageStatus @default(RESERVED)
  maxInputTokens      BigInt        @map("max_input_tokens")
  maxOutputTokens     BigInt        @map("max_output_tokens")
  reservedCostMicros  BigInt        @map("reserved_cost_micros")
  estimatedCostMicros BigInt?       @map("estimated_cost_micros")
  inputTokens         BigInt?       @map("input_tokens")
  outputTokens        BigInt?       @map("output_tokens")
  actualCostMicros    BigInt?       @map("actual_cost_micros")
  chargedTokens       BigInt?       @map("charged_tokens")
  chargedCostMicros   BigInt?       @map("charged_cost_micros")
  latencyMs           Int?          @map("latency_ms")
  completedAt         DateTime?     @map("completed_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  budget  AiBudgetPolicy @relation(fields: [budgetId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, operationId, attemptNumber])
  @@index([companyId, status, createdAt])
  @@map("ai_usage_attempts")
}
